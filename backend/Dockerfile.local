# ============================================================================
# Backend Production Dockerfile (No Raw Source Code Included)
# ============================================================================
# Stage 1: Build Stage (Compiles TypeScript to JavaScript)
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root monorepo files
COPY package*.json ./
COPY packages ./packages
COPY backend/package*.json ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/src ./backend/src

# Install dependencies and compile TypeScript
RUN npm install
RUN npm run build --workspace=@kloqo/shared
RUN npm run build --workspace=kloqo-v2-backend

# ────────────────────────────────────────────────────────────────────────────
# Stage 2: Production Stage (Contains ONLY compiled JavaScript)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Copy compiled dist folder and production node_modules only
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/backend/package*.json ./backend/
COPY --from=builder /app/backend/dist ./backend/dist

EXPOSE 3001

# Run the compiled dist/index.js (No TypeScript source files exist in this runner image)
CMD ["node", "backend/dist/backend/src/infrastructure/webserver/express/index.js"]
